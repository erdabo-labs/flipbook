# Copy to .env.local for development, .env.production for Compose runtime.
# Set privately. DATABASE_URL and OPENAI_API_KEY must remain server-side.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
# APP_ORIGIN must exactly match the browser origin on your LAN or Teleport VPN.
# Compose interpolation: set these in your shell or a separate .env file (no secrets).
# Keep the default loopback binding or use an explicitly selected private interface.
# APP_BIND_IP=127.0.0.1
# APP_PORT=3000
